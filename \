module Logic where
import Data.List (nub)

p_and_not_p :: Prop -> Prop
p_and_not_p prop = Land prop (Lnot prop)

p_or_not_p :: Prop -> Prop
p_or_not_p prop = Lor prop (Lnot prop)

data Prop
  = Land Prop Prop
  | FlatAnd [Prop]
  | Lor Prop Prop
  | FlatOr [Prop]
  | Leq Prop Prop
  | Lnot Prop
  | Value Bool
  | Symbol String
  deriving (Show, Eq)

neg :: Prop -> Prop
neg (Land p q) = (Lor (neg p) (neg q))
neg (FlatAnd ps) = FlatOr (map neg ps)
neg (Lor p q) = (Land (neg p) (neg q))
neg (FlatOr ps) = FlatAnd (map neg ps)
neg (Leq p q) = (Leq (neg p) q)
neg (Lnot p) = p
neg (Value b) = Value (not b)
neg (Symbol name) = Lnot (Symbol name)

implies :: Prop -> Prop -> Bool
implies p q
  | simplify p == simplify q = True
implies (Lor p q) r = p `implies` r || q `implies` r
implies (FlatOr ps) r = any (`implies` r) ps
implies a (Land b c) = a `implies` b || a `implies` c
implies a (FlatAnd bs) = all (a `implies`) bs
implies _ _ = False

trivially_true :: Prop -> Bool
trivially_true (Value True) = True
trivially_true (Land l r) = trivially_true l && trivially_true r
trivially_true (FlatAnd ps) = all trivially_true ps
trivially_true (Lor l r) = trivially_true l || trivially_true r
trivially_true (FlatOr ps) = any trivially_true ps
trivially_true (Leq l r) = trivially_true l == trivially_true r
trivially_true _ = False

trivially_false :: Prop -> Bool
trivially_false (Value False) = True
trivially_false (Land l r) = trivially_false l || trivially_false r
trivially_false (FlatAnd ps) = any trivially_false ps
trivially_false (Lor l r) = trivially_false l && trivially_false r
trivially_false (FlatOr ps) = all trivially_false ps
trivially_false (Leq l r) = trivially_false l /= trivially_false r
trivially_false _ = False

dedup_flat :: [Prop] -> [Prop]
dedup_flat ps = nub ps



simplify :: Prop -> Prop
simplify p
  | trivially_true p = Value True
  | trivially_false p = Value False
simplify (Lnot (Lnot p)) = simplify p
-- simplify (Land (Lnot p) (Lnot q)) = Lnot (Lor (simplify p) (simplify q))
simplify (Lnot (FlatAnd ps)) = FlatOr (map (simplify . neg) ps)
-- simplify (Lor (Lnot p) (Lnot q)) = Lnot (Land (simplify p) (simplify q))
simplify (Lnot (FlatOr ps)) = FlatAnd (map (simplify . neg) ps)
simplify (Land l r)
  | l == r = simplify l
  | l == (Lnot r) = Value False
  | r == (Lnot l) = Value False
  | l `implies` r = simplify r
  | r `implies` l = simplify l
  | otherwise = (Land (simplify l) (simplify r))
simplify (FlatAnd ps) = FlatAnd core
  where core = [p | p <- ps, q <- ps, q `implies` p]
simplify (Lor l r)
  | l == r = simplify l
  | l == (Lnot r) = Value True
  | r == (Lnot l) = Value True
  | l `implies` r = simplify l
  | r `implies` l = simplify r
  | otherwise = (Lor (simplify l) (simplify r))
simplify (Leq l r)
  | l == r = Value True
  | otherwise = Leq (simplify l) (simplify r)
simplify p = p

simplify_loop :: Prop -> Prop
simplify_loop p0 =
  if (p0 == p1) then p1 else simplify_loop p1
  where
    p1 = simplify p0
